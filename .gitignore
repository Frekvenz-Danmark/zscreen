# ── ESP-IDF build ──────────────────────────────────────────────────
build/
firmware/build/
sdkconfig
sdkconfig.old
sdkconfig.ci
dependencies.lock
managed_components/
*.bin
*.elf
*.map

# ── Host-test build ────────────────────────────────────────────────
tests/host/build/
tests/host/*.o
tests/host/run

# ── Byggede vaerktoejer ────────────────────────────────────────────
# zs-probe bygges af tools/zs-probe/build.sh. Den binaere fil hoerer
# ikke i git: den er 60 KB, aendrer sig ved hver oversaettelse, og kan
# bygges paa et sekund.
tools/zs-probe/zs-probe
tools/zs-probe/*.dSYM/

# ── Genererede assets (bygges af tools/build-assets.sh) ────────────
# Fontene og ikonerne genereres fra TTF. Vi comitter dem alligevel,
# fordi de skal kunne bygges uden node installeret. Mellemfilerne
# skal derimod ikke med.
tools/.assets-cache/
tools/.fonts/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Signeringsnoeglen ──────────────────────────────────────────────
# Den vigtigste fil i hele projektet.
#
#   Mistes den, kan ingen enhed nogensinde opdateres igen.
#   Laekker den, kan enhver skubbe firmware ud til alle skaerme.
#
# Den ligger i secure/ og skal ALDRIG i git. Den samme noegle ligger
# som hemmeligheden SIGNING_KEY paa GitHub, hvor kun udgivelses-
# arbejdsgangen kan naa den. Tag ogsaa en kopi et sikkert sted udenfor
# begge dele.
secure/

# ── Brandmateriale ─────────────────────────────────────────────────
# Logofilerne i deres originale form bliver liggende lokalt. De
# faerdige C-filer i firmware/main/ui/assets kommer med, saa enhver
# kan bygge firmwaren, men de raa filer er ikke frit tilgaengelige.
brand/

# ── Hemmeligheder ──────────────────────────────────────────────────
# Skaermen har ingen cloud og ingen noegler, men vi lukker doeren
# alligevel saa et uheld ikke bliver til en lakage.
*.pem
*.key
secrets.h
wifi-credentials.*
.env
.env.*

# ── macOS / editor ─────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp

# Lyd- og videofiler hoerer ikke til i firmwaren. Enheden har ingen
# hoejttaler: Seeeds eget board-modul har FUNC_I2S_EN paa nul og
# codec_ops paa NULL, saa der er ingen vej ud for lyd. Det eneste der
# findes er en summer paa RP2040'erens GPIO 19, og den kan give ét bip.
*.mp3
*.wav
*.mp4
*.mov
